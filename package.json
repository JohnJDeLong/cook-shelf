{
  "name": "cook-shelf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --kill-others-on-fail --names web,studio --prefix-colors cyan,magenta \"pnpm dev\" \"pnpm db:studio\"",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
